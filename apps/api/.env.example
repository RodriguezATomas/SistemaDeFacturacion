# ─── API: configuración por variables de entorno ───
NODE_ENV=development
PORT=3000
# saas = multiempresa con planes/suscripciones | private = instalación propia de una empresa
DEPLOYMENT_MODE=saas
# URL pública del frontend (CORS y enlaces en emails)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://facturacion:facturacion@localhost:5432/facturacion?schema=public

# JWT: secretos de al menos 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Clave AES-256 (32 bytes en base64) para cifrar certificados/claves de ARCA en la base:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=

# ARCA
# Timeout de solicitudes a los web services (ms)
ARCA_TIMEOUT_MS=30000
# Los servidores de ARCA usan parámetros DH antiguos; SECLEVEL=1 permite el handshake TLS con OpenSSL 3.
ARCA_TLS_CIPHERS=DEFAULT@SECLEVEL=1
# Habilita el ambiente de producción de ARCA (procedimiento controlado, ver docs/ARCA_INTEGRATION.md)
ARCA_PRODUCTION_ENABLED=false

# Almacenamiento de archivos: s3 | local
STORAGE_DRIVER=s3
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=facturacion
S3_ACCESS_KEY=facturacion
S3_SECRET_KEY=facturacion-dev-secret
S3_FORCE_PATH_STYLE=true

# Email (Mailpit en desarrollo: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Sistema de Facturación <no-reply@facturacion.local>"

# Logs en JSON (recomendado en producción)
LOG_JSON=false

# Seed: administrador de plataforma SaaS (solo se crea si ambas variables están definidas)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
