{
  "name": "@facturacion/api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST (NestJS) del Sistema Integral de Gestión y Facturación",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --config jest.config.ts",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "node scripts/with-env.cjs prisma migrate dev",
    "prisma:migrate:deploy": "node scripts/with-env.cjs prisma migrate deploy",
    "prisma:seed": "node scripts/with-env.cjs ts-node --transpile-only prisma/seed.ts",
    "setup:private": "node scripts/with-env.cjs ts-node --transpile-only prisma/setup-private.ts",
    "arca:check": "ts-node --transpile-only scripts/arca-check.ts",
    "prisma:studio": "node scripts/with-env.cjs prisma studio"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "deepmerge-ts": "8.0.2",
    "fast-xml-parser": "5.12.1",
    "helmet": "8.1.0",
    "node-forge": "1.4.3",
    "nodemailer": "10.6.0",
    "pdfkit": "0.17.2",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.10",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.1",
    "@types/node-forge": "1.3.14",
    "@types/pdfkit": "0.17.3",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "jest": "29.7.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
