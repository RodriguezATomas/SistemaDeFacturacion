# ─── Variables para docker compose (copiar a .env y completar) ───
# Modalidad de despliegue: saas | private
DEPLOYMENT_MODE=saas

POSTGRES_USER=facturacion
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=facturacion
POSTGRES_PORT=5432

# Almacenamiento compatible con S3 (SeaweedFS en docker compose)
S3_ACCESS_KEY=facturacion
S3_SECRET_KEY=cambiar-esta-clave-s3
S3_BUCKET=facturacion

# Secretos de la API (generar valores aleatorios, ver docs/DEPLOYMENT.md)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

API_PORT=3000
WEB_PORT=8080
APP_URL=http://localhost:8080
